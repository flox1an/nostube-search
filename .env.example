# ── Required ─────────────────────────────────────────────────────────────────

# MeiliSearch master key — set a strong random value in production
MEILI_MASTER_KEY=nostube-search-master-key


# ── Data persistence ──────────────────────────────────────────────────────────

# Host path for persistent data (MeiliSearch index + cache files).
# Defaults to ./data — override to an absolute path for Coolify volume mounts.
# DATA_PATH=./data


# ── API ───────────────────────────────────────────────────────────────────────

# Port the search API listens on (host side)
# API_PORT=3001


# ── MeiliSearch ───────────────────────────────────────────────────────────────

# MeiliSearch environment: "development" enables the UI dashboard at /
# MEILI_ENV=production

# Uncomment to expose MeiliSearch directly on the host (useful for debugging)
# MEILI_PORT=7700


# ── Indexer ───────────────────────────────────────────────────────────────────

# Comma-separated Nostr relay URLs used to fetch video events
NOSTR_SOURCE_RELAYS=wss://relay.nostu.be

# Comma-separated Nostr relay URLs used to fetch author kind-0 profiles
NOSTR_INDEX_RELAYS=wss://relay.nostu.be

# Per-query timeout when fetching from the source relay (ms)
# NOSTR_SOURCE_MAX_WAIT_MS=30000

# Whether to fetch trust scores via ContextVM / relatr
# FETCH_TRUST_SCORES=true

# Author profile cache TTL (ms) — default 24 h
# PROFILE_CACHE_TTL_MS=86400000

# Trust score cache TTL (ms) — default 24 h
# TRUST_CACHE_TTL_MS=86400000

# How often the indexer runs an incremental update (ms) — default 10 min
# INDEXER_INCREMENTAL_INTERVAL_MS=600000

# How often the indexer runs a full re-index (ms) — default 24 h
# A full re-index uses a rolling swap: the live index stays queryable throughout.
# INDEXER_FULL_INTERVAL_MS=86400000
