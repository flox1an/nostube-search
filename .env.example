# ── Required ─────────────────────────────────────────────────────────────────

# MeiliSearch master key — set a strong random value in production
MEILI_MASTER_KEY=nostube-search-master-key


# ── API ───────────────────────────────────────────────────────────────────────

# Port the search API listens on (host side)
# API_PORT=3001


# Canonical Nostube origin used in generated sitemap URLs
# SITEMAP_SITE_ORIGIN=https://nostu.be

# Sitemap entry limits. SITEMAP_MAX_URLS is capped at 50000 by the API.
# SITEMAP_MAX_URLS=50000
# SITEMAP_MAX_AUTHORS=5000
# SITEMAP_AUTHOR_MIN_VIDEOS=10

# ── API hardening ─────────────────────────────────────────────────────────────

# Set to true ONLY when the API sits behind a reverse proxy you control.
# When true the rate limiter reads the first X-Forwarded-For hop; when false it
# uses the socket peer address. Enabling this without a proxy lets any client
# forge the header and mint unlimited rate-limit buckets.
# TRUST_PROXY=false

# Per-client request ceilings. Every route is unauthenticated and fans out into
# MeiliSearch and/or Nostr relay queries.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300
# RATE_LIMIT_RECOMMENDATIONS_MAX=20
# RATE_LIMIT_SITEMAP_MAX=10

# Cache-Control emitted on successful GET /api/* responses so a CDN or reverse
# proxy absorbs repeat traffic instead of MeiliSearch.
# API_CACHE_MAX_AGE_S=60
# API_CACHE_SWR_S=300

# Relay hints embedded in a client-supplied nevent/naddr are dialed by the
# recommendations endpoint. Hints are restricted to public wss:// hosts and
# capped in number; raising these widens an SSRF surface.
# RELAY_HINT_MAX=4
# RELAY_HINT_ALLOW_INSECURE=false
# RELAY_HINT_ALLOW_PRIVATE=false
# RELAY_HINT_DNS_TIMEOUT_MS=2000

# ── MeiliSearch ───────────────────────────────────────────────────────────────

# MeiliSearch environment: "development" enables the UI dashboard at /
# MEILI_ENV=production

# Host port for MeiliSearch when published by docker-compose.yml
# MEILI_PORT=7700


# ── Indexer ───────────────────────────────────────────────────────────────────

# Comma-separated Nostr relay URLs used to fetch video events
NOSTR_SOURCE_RELAYS=wss://relay.nostu.be

# Comma-separated Nostr relay URLs used to fetch author kind-0 profiles
NOSTR_INDEX_RELAYS=wss://relay.nostu.be

# Per-query timeout when fetching from the source relay (ms)
# NOSTR_SOURCE_MAX_WAIT_MS=30000

# Whether to fetch trust scores via ContextVM / relatr
# FETCH_TRUST_SCORES=true

# Author profile cache TTL (ms) — default 24 h
# PROFILE_CACHE_TTL_MS=86400000

# Trust score cache TTL (ms) — default 24 h
# TRUST_CACHE_TTL_MS=86400000

# How often the media availability checker runs (ms) — default 10 min
# MEDIA_AVAILABILITY_CHECK_INTERVAL_MS=600000

# Media availability checker batch size and HEAD timeout
# MEDIA_AVAILABILITY_CHECK_BATCH_SIZE=100
# MEDIA_AVAILABILITY_HEAD_TIMEOUT_MS=5000

# Recheck available media after 24 h; retry failed media after 1 h
# MEDIA_AVAILABILITY_STALE_AFTER_MS=86400000
# MEDIA_AVAILABILITY_RETRY_AFTER_MS=3600000

# Lock file path/stale timeout for preventing concurrent availability checks
# MEDIA_AVAILABILITY_LOCK_STALE_MS=1800000

# How often the indexer runs an incremental update (ms) — default 10 min
# INDEXER_INCREMENTAL_INTERVAL_MS=600000

# How often the indexer runs a full re-index (ms) — default 24 h
# A full re-index uses a rolling swap: the live index stays queryable throughout.
# INDEXER_FULL_INTERVAL_MS=86400000

# Set to true temporarily to run one rolling-swap full re-index at startup.
# Remove it after the indexer reports completion.
# FORCE_FULL_REINDEX=false


# ── Safety Presets ─────────────────────────────────────────────────────────────

# Comma-separated Nostr relay URLs used to fetch NIP-78 preset events (kind 30078).
# Falls back to NOSTR_INDEX_RELAYS when unset.
# NOSTR_PRESET_RELAYS=wss://relay.nostu.be

# How long a preset policy is considered fresh (ms) — default 5 min.
# During this period the cached policy is returned without a background refresh.
# PRESET_CACHE_FRESH_TTL_MS=300000

# Maximum age for a stale preset policy (ms) — default 30 min.
# Stale policies are returned while a background refresh runs, so a transient
# relay failure never causes a service outage for active users.
# PRESET_CACHE_MAX_TTL_MS=1800000
